From e6925e3301a641369077f90d8eaa599e7e44b9a9 Mon Sep 17 00:00:00 2001
From: Kankawee Aramrak <kankaweeisci123@gmail.com>
Date: Fri, 20 Nov 2026 01:13:03 +1100
Subject: [PATCH] part/persist: avoid atomic and mutex overhead when
 uninitialized

mca_part_persist_progress() previously executed an atomic fetch-and-add
on block_entry and acquired ompi_part_persist.lock on every call to
opal_progress() before checking whether init_world was still -1.

On ARM64 Cortex-A76 intra-node point-to-point benchmarks where
partitioned communication is unused, this accounted for 38.29% of
user-space CPU cycles. Check init_world == -1 before entering the
atomic/lock path to eliminate unnecessary synchronization overhead.

Signed-off-by: Kankawee Aramrak <kankaweeisci123@gmail.com>
---
 ompi/mca/part/persist/part_persist.h | 31 +++++++++++++++++++++-------
 1 file changed, 24 insertions(+), 7 deletions(-)

diff --git a/ompi/mca/part/persist/part_persist.h b/ompi/mca/part/persist/part_persist.h
index 6ba4ef0ec5..dc028a5030 100644
--- a/ompi/mca/part/persist/part_persist.h
+++ b/ompi/mca/part/persist/part_persist.h
@@ -76,7 +76,7 @@ struct ompi_part_persist_t {
     ompi_request_t        *part_comm_sreq;
     int32_t                part_comm_sready;
     int32_t                init_comms;    
-    int32_t                init_world;
+    opal_atomic_int32_t    init_world;
     int32_t                my_world_rank; /* Because the back end communicators use a world rank, we need to communicate ours 
                                              to set up the requests. */
     opal_atomic_int32_t    block_entry;
@@ -167,6 +167,23 @@ mca_part_persist_progress(void)
     int err;
     size_t i;
 
+    /* Don't do anything till a function in the module is called.
+     * Use acquire load so MPI_THREAD_MULTIPLE sees initialization under weak memory ordering. */
+#if OPAL_USE_GCC_BUILTIN_ATOMICS
+    if (-1 == __atomic_load_n(&ompi_part_persist.init_world, __ATOMIC_ACQUIRE)) {
+        return OMPI_SUCCESS;
+    }
+#elif OPAL_USE_C11_ATOMICS
+    if (-1 == atomic_load_explicit(&ompi_part_persist.init_world, memory_order_acquire)) {
+        return OMPI_SUCCESS;
+    }
+#else
+    if (-1 == ompi_part_persist.init_world) {
+        return OMPI_SUCCESS;
+    }
+    opal_atomic_rmb();
+#endif
+
     /* prevent re-entry, */
     int block_entry = opal_atomic_add_fetch_32(&(ompi_part_persist.block_entry), 1);
     if(1 < block_entry)
@@ -369,9 +386,9 @@ mca_part_persist_precv_init(void *buf,
     mca_part_persist_precv_request_t *recvreq;
 
     /* if module hasn't been called before, flag module to init. */
-    if(-1 == ompi_part_persist.init_world)
-    {
-        ompi_part_persist.init_world = 0;
+    if (-1 == ompi_part_persist.init_world) {
+        int32_t expected = -1;
+        opal_atomic_compare_exchange_strong_rel_32(&ompi_part_persist.init_world, &expected, 0);
     }
 
     /* Allocate a new request */
@@ -439,9 +456,9 @@ mca_part_persist_psend_init(const void* buf,
     mca_part_persist_psend_request_t *sendreq;
 
     /* if module hasn't been called before, flag module to init. */
-    if(-1 == ompi_part_persist.init_world)
-    {
-        ompi_part_persist.init_world = 0;
+    if (-1 == ompi_part_persist.init_world) {
+        int32_t expected = -1;
+        opal_atomic_compare_exchange_strong_rel_32(&ompi_part_persist.init_world, &expected, 0);
     }
 
     /* Create new request object */
-- 
